{
    "name": "kfoobar/laravel-csv-response",
    "description": "CSV Response for Laravel",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=7.3",
        "illuminate/config": ">=7.0",
        "illuminate/console": ">=7.0",
        "illuminate/support": ">=7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "KFoobar\\CsvResponse\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KFoobar\\CsvResponse\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "KFoobar\\CsvResponse\\CsvResponseServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "David Villa",
            "email": "david@kfoobar.se"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
